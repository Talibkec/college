<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_0.xsd"
        version="3.0">
    <description>Editable website content (docs/DYNAMIC_CONTENT_FINDINGS.md). Usage: &lt;%@ taglib prefix="kec" uri="/WEB-INF/kec.tld" %&gt;</description>
    <tlib-version>1.0</tlib-version>
    <short-name>kec</short-name>
    <uri>/WEB-INF/kec.tld</uri>

    <tag>
        <description>Value of a site setting; the body (today's text) is shown when the setting has no value.</description>
        <name>setting</name>
        <tag-class>com.college.core.tags.SettingTag</tag-class>
        <body-content>scriptless</body-content>
        <attribute>
            <name>key</name>
            <required>true</required>
            <rtexprvalue>false</rtexprvalue>
        </attribute>
    </tag>

    <tag>
        <description>Puts the visible entries of a link list into a request attribute (removed if the page should show its own links).</description>
        <name>links</name>
        <tag-class>com.college.core.tags.LinksTag</tag-class>
        <body-content>empty</body-content>
        <attribute>
            <name>list</name>
            <required>true</required>
            <rtexprvalue>false</rtexprvalue>
        </attribute>
        <attribute>
            <name>var</name>
            <required>true</required>
            <rtexprvalue>false</rtexprvalue>
        </attribute>
    </tag>

    <tag>
        <description>Stored HTML of a page section ("page/section"); the body (today's HTML) is shown when there is no row.</description>
        <name>section</name>
        <tag-class>com.college.core.tags.SectionTag</tag-class>
        <body-content>scriptless</body-content>
        <attribute>
            <name>key</name>
            <required>true</required>
            <rtexprvalue>false</rtexprvalue>
        </attribute>
    </tag>

    <function>
        <description>Escapes &lt; &gt; " ' (not &amp;, so character references keep working), see HtmlText.escapeMarkup.</description>
        <name>text</name>
        <function-class>com.college.core.tags.HtmlText</function-class>
        <function-signature>java.lang.String escapeMarkup(java.lang.String)</function-signature>
    </function>
</taglib>
